(deflisten server-name 
	:initial ""
	`mullvad status | grep "Relay:" | awk -F ':' '{print $2}' | xargs`
)

(deflisten server-ip 
	:initial ""
	`mullvad status | grep "Visible location:" | awk -F ':' '{print $3}' | xargs`
)

(deflisten vpn_state
	:initial ""
	`mullvad status | head -n 1`
)

(defwidget mullvad []
	(box
		:class "mullvad"
		:space-evenly false
		(eventbox 
			:onclick {
					"${vpn_state}" == "Connected" ? "mullvad disconnect" :
					"mullvad connect"
			}
			:timeout "2s"
			:cursor "pointer"
			(box
				:space-evenly false
				:spacing 6
				(label :text "󰖂 ")
				(label :text {
					"${vpn_state}" == "Connected" ? "${server-name}:${server-ip}" :
					"Disconnected"
				})
			)
		)
	)
)
