;; TODO: find a more efficient way to handle this
(defpoll vpn-server 
	:initial ""
	:interval "5s"
	`mullvad status | grep "Relay:" | awk -F ':' '{print $2}' | xargs`
)

(deflisten vpn-status
	:initial ""
	`scripts/vpn.sh --status`
)

(defwidget mullvad []
	(box
		:class "mullvad"
		:space-evenly false
		(eventbox 
			:onclick "scripts/vpn.sh --toggle"
			:timeout "5s"
			:cursor "pointer"
			(box
				:space-evenly false
				:spacing 6
				(label :text "󰖂 ")
				(label :text {
					"${vpn-status}" == "connected" ? "${vpn-server}" :
					"Disconnected"
				})
			)
		)
	)
)
